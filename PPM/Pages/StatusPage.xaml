<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinDozer.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinDozer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	>

	<ScrollViewer HorizontalScrollBarVisibility="Auto">
	<StackPanel Spacing="4" Padding="24">

		<InfoBar x:Name="ModeWarning" Severity="Warning" IsOpen="False" IsClosable="False"
			 Title="Power mode is not Balanced"
			 Message="Power plans only take effect when the power mode is Balanced.">
			<InfoBar.ActionButton>
				<Button Content="Reset to Balanced" Click="ResetPowerMode_Click"/>
			</InfoBar.ActionButton>
		</InfoBar>

		<InfoBar x:Name="MissingPlansWarning" Severity="Warning" IsOpen="False" IsClosable="False"
			 Title="Custom power plans not installed"
			 Message="Click to install custom power plans, or set your own in the settings.">
			<InfoBar.ActionButton>
				<Button Content="Install" Click="InstallPowerPlans_Click"/>
			</InfoBar.ActionButton>
		</InfoBar>

		<StackPanel Orientation="Horizontal" Spacing="24" Padding="24">
			<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Current Status: " />
			<FontIcon x:Name="StatusIcon" Glyph="&#xEC49;"/>
			<TextBlock x:Name="StatusText" Style="{StaticResource TitleTextBlockStyle}"/>
		</StackPanel>
		

		<controls:SettingsCard Header="Target Status" Description="Select the status to apply">
			<ComboBox x:Name="ModeCombo" MinWidth="200" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged" >
				<ComboBoxItem Content="Auto"/>
				<ComboBoxItem Content="Idle"/>
				<ComboBoxItem Content="Balanced"/>
				<ComboBoxItem Content="Performance"/>
			</ComboBox>
		</controls:SettingsCard>


		<controls:SettingsCard Header="Reason" Description="The reason for the current status.">
			<TextBlock x:Name="ReasonText"/>
		</controls:SettingsCard>

		<controls:SettingsCard Header="Current PowerPlan" Description="The PowerPlan applied for the current status.">
			<TextBlock x:Name="PlanText"/>
		</controls:SettingsCard>

		<controls:SettingsCard Header="Current PowerMode" Description="The current PowerMode (must be the default Balanced for PowerPlans to work).">
			<TextBlock x:Name="ModeText"/>
		</controls:SettingsCard>

		<controls:SettingsCard Header="IdleTime" Description="Time elapsed since last user input detected.">
			<TextBlock x:Name="IdleTime"/>
		</controls:SettingsCard>
		
		
		
	</StackPanel>
	</ScrollViewer>

</Page>
